banner: "
 oooooo   oooo            
 \`888.   .8'             
  \`888. .8'     oooooooo 
   \`888.8'     d'\"\"7d8P  
    \`888'        .d8P'   
     888       .d8P'  .P 
    o888o     d8888888P  

Yz :: v0.0.1 :: a language where everything is a block of code

async by default · structural typing · no null · nothing to install

type examples or documentation · tab completes · enter runs
___________________________________________________________________
"

documentation: "showing documentation"
examples: "showing examples"
compile: "compiling..."
run: "running"
clear: "clearing..."

help: "
commands: 

examples — browse runnable snippets
docs     — open a topic in the side column
           about the yzc compiler
compile  — 
run      — re-run the last snippet
clear    — empty the screen
help     — this list
exit     — 
"

print(banner)

keep_going : true

while({ keep_going }, {
  option: read("Yz> ")
  match 
    { option == "docs" => print(documentation) },
    { option == "examples" => print(examples) }, 
    { option == "compile" => print(compile) },
    { option == "run" => print(run) },
    { option == "clear" => print(clear) },
    { option == "help" => print(help) },
    { option == "exit" => keep_going = false },
    { print("command not found: ${option} — type help") }
})
